{
  "name": "@castle-control/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./steward": "./src/steward/index.ts",
    "./steward-flow": "./src/steward-flow/index.ts",
    "./design": "./src/design/index.ts",
    "./custom-design": "./src/design/custom.ts",
    "./living-preview": "./src/design/living-preview.tsx",
    "./duel": "./src/duel/index.ts",
    "./stamp": "./src/stamp/table.ts",
    "./stamp.css": "./src/stamp/stamp.css",
    "./fused/rampart.css": "./src/fused/rampart.css",
    "./fused/surface.css": "./src/fused/surface.css",
    "./fused/glass.css": "./src/fused/glass.css",
    "./fused/folio.css": "./src/fused/folio.css",
    "./chamber": "./src/chamber/index.ts",
    "./fused/surface-transition": "./src/fused/surface-transition.tsx",
    "./action-row": "./src/action-row/index.tsx"
  },
  "sideEffects": [
    "./src/kit.tsx",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite kit --host 127.0.0.1",
    "build": "vite build kit --outDir ../dist && node src/check-build.ts",
    "typecheck": "node ../../scripts/package-gate.mjs typecheck",
    "lint": "node ../../scripts/package-gate.mjs lint",
    "test": "node ../../scripts/package-gate.mjs test"
  },
  "dependencies": {
    "@castle-control/contract": "workspace:*",
    "@castle-control/tokens": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@castle-control/duel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
